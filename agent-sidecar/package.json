{
  "name": "agent-sidecar",
  "version": "1.0.0",
  "description": "Headless Node.js agent runner using Pi SDK for Rusty",
  "main": "dist/server.js",
  "scripts": {
    "dev": "PORT=4001 ../src-tauri/bin/node-aarch64-apple-darwin ./node_modules/ts-node/dist/bin.js src/server.ts",
    "build": "npm run typecheck && ../src-tauri/bin/node-aarch64-apple-darwin ./node_modules/tsup/dist/cli-default.js src/server.ts --format cjs,esm --dts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test -r ./node_modules/ts-node/register \"src/**/*.test.ts\"",
    "test:llm": "node --test -r ./node_modules/ts-node/register src/services/llmProviders.test.ts src/services/llmRuntime.test.ts src/services/copilotService.test.ts src/services/codexService.test.ts src/services/providerQuota.test.ts",
    "test:architecture": "node --test -r ./node_modules/ts-node/register src/services/websocket.test.ts src/services/agentProtocol.test.ts src/services/eventPersistence.test.ts src/services/delegationManager.test.ts src/capabilities/reconciliateGraph.test.ts",
    "start": "../src-tauri/bin/node-aarch64-apple-darwin dist/server.js",
    "node:version": "../src-tauri/bin/node-aarch64-apple-darwin --version",
    "postinstall": "rm -rf node_modules/@earendil-works/pi-coding-agent/node_modules/undici && patch-package"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@earendil-works/pi-agent-core": "^0.79.10",
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@earendil-works/pi-tui": "0.79.10",
    "@github/copilot-sdk": "^1.0.7",
    "@openai/codex": "^0.144.6",
    "@tintinweb/pi-subagents": "^0.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jiti": "^2.7.0",
    "pi-mcp-extension": "^1.5.0",
    "pi-web-access": "^0.13.0",
    "undici": "6.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "undici": "6.21.1"
  }
}
