{
  "name": "rusty",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:sidecar": "npm --prefix agent-sidecar run typecheck",
    "test:sidecar": "npm --prefix agent-sidecar run test",
    "pretest:rust": "node scripts/ensure-sidecar-resources.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "prelint:rust": "node scripts/ensure-sidecar-resources.mjs",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm run typecheck:test && npm run theme:check && npm run test && npm run build && npm run typecheck:sidecar && npm run test:sidecar && npm run test:rust",
    "theme:check": "node scripts/check-theme-usage.mjs",
    "icons:generate": "tauri icon public/rusty-dark.png && node scripts/prune-mobile-icons.mjs",
    "build:sidecar": "npm --prefix agent-sidecar run build && node scripts/prepare-sidecar-runtime.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.11.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
