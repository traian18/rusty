{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty-IDE",
  "version": "0.1.18",
  "identifier": "com.suciuvictortraian.rusty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rusty IDE",
        "width": 800,
        "height": 600,
        "maximized": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/sidecar"],
    "macOS": {
      "signingIdentity": "Developer ID Application: Suciu Victor Traian (XH3PAKPS6T)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
